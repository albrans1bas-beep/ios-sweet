 static uint64_t sweet_sandbox_seen;
 
+/*
+ * Dump the first few container-path requests (op 4) including the
+ * buffers their pointers reference, so the request layout can be
+ * recovered from the guest log.  Diagnostic only: op 4 still returns
+ * ENOENT.
+ */
+static int sweet_sandbox_dumps_left = 6;
+
+static void
+sweet_sandbox_dump_req(struct proc *p, int call, user_addr_t arg)
+{
+	uint8_t buf[72];
+	uint8_t tgt[96];
+	user_addr_t ptrs[4];
+	static const int offs[] = { 0x10, 0x28, 0x30, 0x38 };
+	char name[32];
+	unsigned i, j;
+
+	if (call != 4 || sweet_sandbox_dumps_left <= 0 || arg == 0 ||
+	    copyin(arg, buf, sizeof(buf)) != 0) {
+		return;
+	}
+	sweet_sandbox_dumps_left--;
+	proc_name(proc_pid(p), name, sizeof(name));
+	printf("SWEET Sandbox: %s op %d req at %#llx\n",
+	    name, call, (unsigned long long)arg);
+	for (i = 0; i + 15 < sizeof(buf); i += 16) {
+		printf("SWEET SB %2d: %02x %02x %02x %02x %02x %02x %02x %02x "
+		    "%02x %02x %02x %02x %02x %02x %02x %02x\n",
+		    i, buf[i], buf[i+1], buf[i+2], buf[i+3],
+		    buf[i+4], buf[i+5], buf[i+6], buf[i+7],
+		    buf[i+8], buf[i+9], buf[i+10], buf[i+11],
+		    buf[i+12], buf[i+13], buf[i+14], buf[i+15]);
+	}
+	for (j = 0; j < 4; j++) {
+		uint64_t v;
+
+		memcpy(&v, buf + offs[j], sizeof(v));
+		ptrs[j] = v ? (user_addr_t)v : 0;
+	}
+	for (j = 0; j < 4; j++) {
+		if (ptrs[j] == 0 || copyin(ptrs[j], tgt, sizeof(tgt)) != 0) {
+			continue;
+		}
+		printf("SWEET SB ptr @0x%x:\n", offs[j]);
+		for (i = 0; i + 15 < sizeof(tgt); i += 16) {
+			printf("SWEET SBp %2d: %02x %02x %02x %02x %02x %02x %02x %02x "
+			    "%02x %02x %02x %02x %02x %02x %02x %02x\n",
+			    i, tgt[i], tgt[i+1], tgt[i+2], tgt[i+3],
+			    tgt[i+4], tgt[i+5], tgt[i+6], tgt[i+7],
+			    tgt[i+8], tgt[i+9], tgt[i+10], tgt[i+11],
+			    tgt[i+12], tgt[i+13], tgt[i+14], tgt[i+15]);
+		}
+	}
+}
+
 static int
 sweet_sandbox_syscall(struct proc *p, int call, __unused user_addr_t arg)
 {
@@ -296,6 +352,8 @@
 	}
 	switch (call) {
 	case 4:         /* container path (audit token / pid) */
