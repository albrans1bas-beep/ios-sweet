@@ -0,0 +1,1249 @@
+/*
+ * SWEET virtio (QEMU virt board): virtio-mmio transport + virtio-blk disk.
+ *
+ * QEMU places modern virtio-mmio transports at 0x0a000000 (stride 0x200); the
+ * ADT `/sweet-virtio` node gives the reg of the one we use. QEMU runs them
+ * with force-legacy off (virtio mmio version 2 register layout), and the
+ * device is virtio-blk (`-device virtio-blk-device`).
+ *
+ * One split ring lives in a contiguous DMA allocation (QEMU is coherent and
+ * the emulated CPU treats cache maintenance as a no-op, but the sync calls
+ * keep the code correct on non-coherent boards too). Requests are issued one
+ * at a time through a bounce buffer and completion is polled on the used ring
+ * index, so no interrupt wiring is needed.
+ *
+ * The device appears as the BSD disk vroot0 (rvroot0) with the whole device
+ * as one partition; root on it with rd=vroot0 (IOFindBSDRoot). Reads and
+ * writes both work.
+ *
+ * The same window carries QEMU's virtio-input devices (tablet/keyboard/mouse),
+ * which are polled and turned into HID touch/key events for backboardd.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/errno.h>
+#include <sys/kernel.h>
+#include <sys/proc.h>
+#include <sys/proc_internal.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <kern/sched_prim.h>
+#include <kern/task.h>
+#include <kern/thread.h>
+#include <arm/thread.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+/* osfmk/arm/machine_routines.h, not exported to the BSD layer */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+/* virtio-mmio modern (version 2) register layout (virtio spec 1.2, table 4.1) */
+#define REG_MAGIC           0x000
+#define REG_VERSION         0x004
+#define REG_DEVICE_ID       0x008
+#define REG_VENDOR_ID       0x00c
+#define REG_DEVICE_FEATURES 0x010
+#define REG_DEVICE_FEAT_SEL 0x014
+#define REG_DRIVER_FEATURES 0x020
+#define REG_DRIVER_FEAT_SEL 0x024
+#define REG_QUEUE_SEL       0x030
+#define REG_QUEUE_NUM_MAX   0x034
+#define REG_QUEUE_NUM       0x038
+#define REG_QUEUE_READY     0x044
+#define REG_QUEUE_NOTIFY    0x050
+#define REG_IRQ_STATUS      0x060
+#define REG_STATUS          0x070
+#define REG_QUEUE_DESC_LO   0x080
+#define REG_QUEUE_DESC_HI   0x084
+#define REG_QUEUE_AVAIL_LO  0x090
+#define REG_QUEUE_AVAIL_HI  0x094
+#define REG_QUEUE_USED_LO   0x0a0
+#define REG_QUEUE_USED_HI   0x0a4
+#define REG_CONFIG          0x100
+
+#define VSIG_MAGIC          0x74726976u   /* "virt" */
+#define VDEV_ID_BLK         2
+#define VERSION_MMIO        2
+/* the strap of transports at the ADT base (32 slots of 0x200 bytes) */
+#define VPOS_STRIDE         0x200u
+
+#define VST_ACKNOWLEDGE     1u
+#define VST_DRIVER          2u
+#define VST_DRIVER_OK       4u
+#define VST_FEATURES_OK     8u
+
+#define FEAT_VERSION_1      (1ull << 32)   /* VIRTIO_F_VERSION_1: bit 0 of page 1 */
+
+/* virtio_blk.h */
+#define VB_REQ_READ         0
+#define VB_REQ_WRITE        1
+#define VB_RESP_OK          0x00
+#define VB_RESP_IOERR       0x01
+
+struct vdesc {
+	uint64_t addr;
+	uint32_t len;
+	uint16_t flags;
+	uint16_t next;
+} __attribute__((packed));
+
+struct vring_used_elem {
+	uint32_t id;
+	uint32_t len;
+} __attribute__((packed));
+
+#define VRING_DESC_F_NEXT   1u
+#define VRING_DESC_F_WRITE  2u
+
+struct vbhdr {
+	uint32_t type;
+	uint32_t reserved;
+	uint64_t sector;
+} __attribute__((packed));
+
+#define BOUNCE_SIZE         (1u << 20)
+#define REQUEST_TIMEOUT_NS  (30ull * NSEC_PER_SEC)
+#define VRING_SIZE          256         /* <= QueueNumMax of QEMU bl */
+
+/* Layout of the contiguous DMA allocation. 0x0000 is the descriptor page
+ * (256 * 16 = exactly one page); avail + request header + status on the next
+ * page, used ring on a further page, then the bounce buffer. */
+#define OFF_DESC            0x0000
+#define OFF_AVAIL           0x1000      /* flags, idx, ring[num], used_event */
+#define OFF_HDR             (OFF_AVAIL + 0x400)
+#define OFF_RESP            (OFF_AVAIL + 0x420)
+#define OFF_USED            0x2000      /* flags, idx, used[num], avail_event */
+#define OFF_BOUNCE          0x4000
+#define DMA_SIZE            (OFF_BOUNCE + BOUNCE_SIZE)
+
+/* avail/used ring indices */
+#define AVAIL_IDX(d)        (*(volatile uint16_t *)((uint8_t *)(d) + OFF_AVAIL + 2))
+#define AVAIL_RING(d, i)    (*(volatile uint16_t *)((uint8_t *)(d) + OFF_AVAIL + 4 + 2 * ((i) & (VRING_SIZE - 1))))
+#define USED_IDX(d)         (*(volatile uint16_t *)((uint8_t *)(d) + OFF_USED + 2))
+#define USED_EL(d, i)       (*(volatile struct vring_used_elem *)((uint8_t *)(d) + OFF_USED + 4 + 8 * ((i) & (VRING_SIZE - 1))))
+
+static struct {
+	vm_offset_t regs;
+	vm_offset_t dma;                    /* kernel VA of the DMA allocation */
+	uint64_t dma_pa;
+	uint32_t req_count;                 /* avail cursor (u32 free running) */
+	uint16_t seen_used;                 /* mirror of the device's used idx */
+	uint64_t capacity;                  /* 512-byte sectors */
+	uint32_t secsize;
+	bool writable;
+	int bmajor, cmajor;
+	dev_t bdev;
+	bool ready;
+} sv;
+
+static LCK_GRP_DECLARE(sweet_vio_grp, "sweet_vio");
+static LCK_MTX_DECLARE(sweet_vio_lock, &sweet_vio_grp);
+
+static inline uint32_t
+vio_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(sv.regs + off);
+}
+
+static inline void
+vio_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(sv.regs + off) = v;
+}
+
+static inline uint64_t
+vio_rd64(uint32_t off)
+{
+	return (uint64_t)vio_rd(off) | ((uint64_t)vio_rd(off + 4) << 32);
+}
+
+/* cache maintenance over the whole DMA region; QEMU's TCG has no data cache,
+ * so these are no-ops there but keep the code honest for real boards (VA). */
+static void
+vio_sync_all(bool write)
+{
+	if (write) {
+		CleanPoC_DcacheRegion(sv.dma, DMA_SIZE);
+	} else {
+		FlushPoC_DcacheRegion(sv.dma, DMA_SIZE);
+	}
+}
+
+static void
+vio_init_ring_memory(void)
+{
+	struct vdesc *desc = (struct vdesc *)(sv.dma + OFF_DESC);
+
+	/* 3 descriptors per request; only whole chains fit the ring (256 % 3 != 0),
+	 * so requests cycle bases 0, 3, ..., NCHAIN*3-3 and desc[N*3..] stay unused. */
+	for (uint16_t id = 0; id + 3 <= VRING_SIZE; id += 3) {
+		desc[id + 0].flags = VRING_DESC_F_NEXT;
+		desc[id + 0].next = (uint16_t)(id + 1);
+		desc[id + 1].flags = VRING_DESC_F_NEXT;
+		desc[id + 1].next = (uint16_t)(id + 2);
+		desc[id + 2].flags = VRING_DESC_F_WRITE;
+		desc[id + 2].next = 0;
+	}
+	/* headers, responses and bounce are filled per request */
+	AVAIL_IDX(sv.dma) = 0;                  /* we are at avail cursor 0 */
+	USED_IDX(sv.dma) = 0;
+	sv.seen_used = 0;
+	sv.req_count = 0;
+}
+
+static int
+vio_transport_setup(void)
+{
+	/* magic/version/deviceId were verified by the transport scan in sweet_vio_init */
+	printf("SWEET VIO: virtio-blk, vendor 0x%04x\n", vio_rd(REG_VENDOR_ID));
+
+	/* reset */
+	vio_wr(REG_STATUS, 0);
+	while (vio_rd(REG_STATUS)) {
+		delay(10);
+	}
+
+	vio_wr(REG_STATUS, VST_ACKNOWLEDGE);
+	vio_wr(REG_STATUS, VST_ACKNOWLEDGE | VST_DRIVER);
+
+	/* negotiate VERSION_1 (page 1 of the 64-bit feature space) */
+	vio_wr(REG_DEVICE_FEAT_SEL, 1);
+	if (!(vio_rd(REG_DEVICE_FEATURES) & 1)) {
+		printf("SWEET VIO: device does not offer VIRTIO_F_VERSION_1\n");
+		return ENXIO;
+	}
+	vio_wr(REG_DRIVER_FEAT_SEL, 1);
+	vio_wr(REG_DRIVER_FEATURES, 1);         /* want the device-derived layout */
+	vio_wr(REG_STATUS, VST_ACKNOWLEDGE | VST_DRIVER);
+	vio_wr(REG_STATUS, VST_ACKNOWLEDGE | VST_DRIVER | VST_FEATURES_OK);
+	if (!(vio_rd(REG_STATUS) & VST_FEATURES_OK)) {
+		printf("SWEET VIO: FEATURES_OK rejected\n");
+		return EIO;
+	}
+
+	/* one queue */
+	vio_wr(REG_QUEUE_SEL, 0);
+	uint32_t max = vio_rd(REG_QUEUE_NUM_MAX);
+	if (max < 8) {
+		printf("SWEET VIO: empty queue (max %u)\n", max);
+		return ENXIO;
+	}
+	if (max < VRING_SIZE) {
+		printf("SWEET VIO: QueueNumMax %u < %u\n", max, VRING_SIZE);
+		return ENXIO;
+	}
+	vio_wr(REG_QUEUE_NUM, VRING_SIZE);
+	vio_wr(REG_QUEUE_READY, 0);
+	vio_wr(REG_QUEUE_DESC_LO, (uint32_t)(sv.dma_pa + OFF_DESC));
+	vio_wr(REG_QUEUE_DESC_HI, (uint32_t)((sv.dma_pa + OFF_DESC) >> 32));
+	vio_wr(REG_QUEUE_AVAIL_LO, (uint32_t)(sv.dma_pa + OFF_AVAIL));
+	vio_wr(REG_QUEUE_AVAIL_HI, (uint32_t)((sv.dma_pa + OFF_AVAIL) >> 32));
+	vio_wr(REG_QUEUE_USED_LO, (uint32_t)(sv.dma_pa + OFF_USED));
+	vio_wr(REG_QUEUE_USED_HI, (uint32_t)((sv.dma_pa + OFF_USED) >> 32));
+	vio_wr(REG_QUEUE_READY, 1);
+
+	vio_wr(REG_STATUS, VST_ACKNOWLEDGE | VST_DRIVER | VST_FEATURES_OK | VST_DRIVER_OK);
+
+	sv.capacity = vio_rd64(REG_CONFIG);
+	if (sv.capacity == 0) {
+		printf("SWEET VIO: capacity is 0\n");
+		return ENXIO;
+	}
+
+	printf("SWEET VIO: ring %u descriptors, capacity %llu sectors (%llu MiB)\n",
+	    VRING_SIZE, sv.capacity, sv.capacity >> 11);
+	return 0;
+}
+
+/*
+ * One request: descriptors [id, id+1) chain to data, data chains to resp.
+ * Bounce-buffer style: data sits in our own DMA space whatever its size.
+ */
+static int
+vio_request(bool write, uint64_t sector, uint32_t len)
+{
+	/* whole chains only: a 3-desc chain starting at 255 would need desc[256],
+	 * which is outside the ring — QEMU then fails the chain and breaks the
+	 * device (all later requests stall, used idx frozen). */
+	uint16_t base = (uint16_t)((sv.req_count % (VRING_SIZE / 3)) * 3);
+	struct vdesc *desc = (struct vdesc *)(sv.dma + OFF_DESC);
+	struct vbhdr *hdr = (struct vbhdr *)(sv.dma + OFF_HDR);
+
+	if (len > BOUNCE_SIZE) {
+		return EINVAL;
+	}
+	if ((sector + (len >> 9)) > sv.capacity || (len & 0x1ff)) {
+		return EINVAL;
+	}
+	if (write && !sv.writable) {
+		return EROFS;
+	}
+
+	hdr->type = write ? VB_REQ_WRITE : VB_REQ_READ;
+	hdr->reserved = 0;
+	hdr->sector = sector;
+	/* descriptor 0: virtio-blk header (device reads it) */
+	desc[base].addr = sv.dma_pa + OFF_HDR;
+	desc[base].len = sizeof(*hdr);
+	desc[base].flags = VRING_DESC_F_NEXT;
+	desc[base].next = (uint16_t)(base + 1);
+	/* descriptor 1: the data; device writes it on reads, only reads it on
+	 * writes (VRING_DESC_F_WRITE means the DEVICE may write the buffer -
+	 * setting it on a write request breaks the in/out split in QEMU). */
+	desc[base + 1].addr = sv.dma_pa + OFF_BOUNCE;
+	desc[base + 1].len = len;
+	desc[base + 1].flags = VRING_DESC_F_NEXT | (write ? 0 : VRING_DESC_F_WRITE);
+	desc[base + 1].next = (uint16_t)(base + 2);
+	/* descriptor 2: the one-byte bl status (device writes it) — also the
+	 * 'zero sized buffers are not allowed' guard: it must never be 0. */
+	desc[base + 2].addr = sv.dma_pa + OFF_RESP;
+	desc[base + 2].len = 1;
+	desc[base + 2].flags = VRING_DESC_F_WRITE;
+	desc[base + 2].next = 0;
+
+	vio_sync_all(true);
+	__builtin_arm_dsb(0xf);
+
+	/* push the descriptor chain head to avail */
+	AVAIL_RING(sv.dma, sv.req_count) = base;
+	vio_sync_all(true);
+	__builtin_arm_dsb(0xf);
+	AVAIL_IDX(sv.dma) = (uint16_t)(++sv.req_count);
+	__builtin_arm_dsb(0xf);
+	vio_wr(REG_QUEUE_NOTIFY, 0);
+
+	/* wait for the device to consume one used ring element; on timeout
+	 * re-notify (a lost kick leaves QEMU's completion stranded) and dump
+	 * ring state before giving up. */
+#define REQUEST_RETRIES        3
+	for (uint8_t attempt = 0; attempt <= REQUEST_RETRIES; attempt++) {
+		uint64_t deadline;
+		nanoseconds_to_absolutetime(REQUEST_TIMEOUT_NS, &deadline);
+		deadline += mach_absolute_time();
+		while ((uint16_t)(sv.seen_used - USED_IDX(sv.dma)) == 0) {
+			if (mach_absolute_time() > deadline) {
+				break;
+			}
+			delay(1);
+		}
+		if ((uint16_t)(sv.seen_used - USED_IDX(sv.dma)) != 0) {
+			break;
+		}
+		if (attempt == REQUEST_RETRIES) {
+			printf("SWEET VIO: request timeout after %u attempts "
+			    "(sector %llu type %u len %u: avail %u used %u "
+			    "desc %llu/%u/%u/%u hdr %llx)\n",
+			    REQUEST_RETRIES + 1, sector, hdr->type, len,
+			    (unsigned)AVAIL_IDX(sv.dma), (unsigned)USED_IDX(sv.dma),
+			    desc[base].addr, desc[base].len, desc[base].flags,
+			    desc[base].next, hdr->sector);
+			return ETIMEDOUT;
+		}
+		printf("SWEET VIO: timeout, re-notifying (attempt %u)\n", attempt + 1);
+		vio_wr(REG_QUEUE_NOTIFY, 0);
+	}
+	vio_sync_all(false);
+	__builtin_arm_dsb(0xf);
+
+	struct vring_used_elem e = USED_EL(sv.dma, sv.seen_used);
+	sv.seen_used++;
+	/* reads carry the data plus the trailing status byte (len+1) */
+	if (e.id != base || e.len > len + 1) {
+		printf("SWEET VIO: bogus used element id %u len %u (want %u/%u)\n",
+		    e.id, e.len, base, len);
+		return EIO;
+	}
+	uint8_t resp = *(volatile uint8_t *)(sv.dma + OFF_RESP);
+	if (resp != VB_RESP_OK) {
+		printf("SWEET VIO: sector %llu %s failed (resp %u)\n",
+		    sector, write ? "write" : "read", resp);
+		return EIO;
+	}
+	return 0;
+}
+
+static int
+vio_read_blocks(uint64_t sector, uint8_t *out, uint32_t count_sectors)
+{
+	int error = vio_request(false, sector, count_sectors * 512);
+	if (error) {
+		return error;
+	}
+	FlushPoC_DcacheRegion(sv.dma + OFF_BOUNCE, count_sectors * 512);
+	memcpy(out, (const void *)(sv.dma + OFF_BOUNCE), count_sectors * 512);
+	return 0;
+}
+
+static int
+vio_write_blocks(uint64_t sector, const uint8_t *in, uint32_t count_sectors)
+{
+	memcpy((void *)(sv.dma + OFF_BOUNCE), in, count_sectors * 512);
+	CleanPoC_DcacheRegion(sv.dma + OFF_BOUNCE, count_sectors * 512);
+	return vio_request(true, sector, count_sectors * 512);
+}
+
+/* devfs entries ------------------------------------------------------------- */
+
+static int
+sweet_vio_open(__unused dev_t dev, int flags, __unused int devtype, __unused struct proc *p)
+{
+	if (!sv.ready) {
+		return ENXIO;
+	}
+	if ((flags & FWRITE) && !sv.writable) {
+		return EROFS;
+	}
+	return 0;
+}
+
+static int
+sweet_vio_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+/* boot-arg sweetproc_dump=SECS: six times, every SECS, print every live
+ * process (ppid pid state comm) into the console ring. Debug aid for stalled
+ * userland bring-up; read the sweet_log_ring dump. */
+static int sweet_proc_ticks;
+static int sweet_proc_left;
+
+static int
+sweet_proc_print(proc_t p, void *arg)
+{
+	printf("SWEET PROC: ppid %d pid %d stat %d comm %s\n",
+	    p->p_ppid, p->p_pid, p->p_stat, p->p_comm);
+	return 0;
+}
+
+static void
+sweet_proc_timer(void *arg)
+{
+	printf("SWEET PROC DUMP: %d to go\n", sweet_proc_left);
+	proc_iterate(PROC_ALLPROCLIST, sweet_proc_print, NULL, NULL, NULL);
+	if (--sweet_proc_left > 0) {
+		timeout(sweet_proc_timer, NULL, sweet_proc_ticks);
+	}
+}
+
+/* boot-arg sweet_sample=SECS: three times, print the user PC/LR (and a short
+ * frame-pointer chain) of every thread of the processes named in
+ * sweet_sample_names (comma separated, default SpringBoard). The boot UI
+ * shares the process with the rest of the shell, so the PCs show what the
+ * stuck startup waits in; lsd is sampled too because LaunchServices calls in
+ * SpringBoard wait for its replies. */
+static int sweet_sample_ticks;
+static int sweet_sample_left;
+static char sweet_sample_names[96];
+
+extern void sweet_sample_task(const char *name, int pid, task_t task);
+
+static int
+sweet_sample_proc(proc_t p, void *arg)
+{
+	char name[32];
+	size_t n;
+	task_t task;
+
+	proc_name(proc_pid(p), name, sizeof(name));
+	n = strlen(name);
+	for (const char *t = sweet_sample_names; *t; ) {
+		const char *end = strchr(t, ',');
+		size_t tl = end ? (size_t)(end - t) : strlen(t);
+		if (tl == n && n > 0 && strncmp(t, name, n) == 0) {
+			task = proc_task(p);
+			if (task != TASK_NULL) {
+				sweet_sample_task(name, proc_pid(p), task);
+			}
+			break;
+		}
+		if (!end) {
+			break;
+		}
+		t = end + 1;
+	}
+	return 0;
+}
+
+static void
+sweet_sample_timer(void *arg)
+{
+	printf("SWEET SAMPLE: tick %d\n", sweet_sample_left);
+	proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, NULL, NULL, NULL);
+	if (--sweet_sample_left > 0) {
+		timeout(sweet_sample_timer, NULL, sweet_sample_ticks);
+	}
+}
+
+/* boot-arg sweetvio_test: verify the block layer in place.
+ * =1 read-only cross-checks (safe on a live root disk): read the same bytes
+ * whole and again in 512/4096/8192/16384-byte pieces, compare.
+ * =2 additionally write a pattern and read it back (test disks only). */
+static void
+sweet_vio_self_test(uint32_t level)
+{
+	const size_t test_sz = 128 * 1024;
+	const uint64_t offs[] = {
+		2048u,                       /* 1 MiB */
+		65536u,                      /* 32 MiB */
+		4194312u,                    /* 2 GiB */
+		(sv.capacity / 2u) & ~(uint64_t)255u,
+		sv.capacity - 257u,          /* last full 128 KiB */
+	};
+	int fails = 0, checks = 0;
+
+	uint8_t *full = kalloc_data(test_sz, Z_WAITOK | Z_ZERO);
+	uint8_t *part = kalloc_data(test_sz, Z_WAITOK | Z_ZERO);
+	if (!full || !part) {
+		printf("SWEET VIO TEST: no memory\n");
+		return;
+	}
+	lck_mtx_lock(&sweet_vio_lock);
+	for (size_t r = 0; r < sizeof(offs) / sizeof(offs[0]); r++) {
+		uint64_t sec = offs[r];
+		if ((sec + test_sz / 512u) > sv.capacity) {
+			continue;
+		}
+		if (vio_read_blocks(sec, full, test_sz / 512u)) {
+			printf("SWEET VIO TEST: sector %llu read failed\n", sec);
+			fails++;
+			continue;
+		}
+		static const uint32_t chunks[] = { 512, 4096, 8192, 16384 };
+		for (size_t c = 0; c < sizeof(chunks) / sizeof(chunks[0]); c++) {
+			uint32_t cs = chunks[c];
+			checks++;
+			for (uint32_t at = 0; at < test_sz; at += cs) {
+				if (vio_read_blocks(sec + at / 512u, part + at, cs / 512u)) {
+					printf("SWEET VIO TEST: sector %llu+%u read failed (chunk %u)\n",
+					    sec, at, cs);
+					fails++;
+					break;
+				}
+			}
+			if (memcmp(full, part, test_sz) == 0) {
+				continue;
+			}
+			for (uint32_t i = 0; i < test_sz; i++) {
+				if (full[i] != part[i]) {
+					printf("SWEET VIO TEST: sector %llu chunk %u byte %u "
+					    "whole 0x%02x vs piece 0x%02x\n",
+					    sec, cs, i, full[i], part[i]);
+					fails++;
+					break;
+				}
+			}
+		}
+		if (level < 2) {
+			continue;
+		}
+		for (uint32_t i = 0; i < test_sz; i += 8) {
+			*(uint64_t *)(part + i) =
+			    ((uint64_t)i << 20) ^ (uint64_t)sec ^ 0x5150454553ULL;
+		}
+		CleanPoC_DcacheRegion((vm_offset_t)part, test_sz);
+		checks++;
+		if (vio_write_blocks(sec, part, test_sz / 512u) ||
+		    vio_read_blocks(sec, full, test_sz / 512u) ||
+		    memcmp(full, part, test_sz) != 0) {
+			printf("SWEET VIO TEST: sector %llu write/readback failed\n", sec);
+			fails++;
+		}
+	}
+	lck_mtx_unlock(&sweet_vio_lock);
+	kfree_data(full, test_sz);
+	kfree_data(part, test_sz);
+	printf("SWEET VIO TEST: level %u: %d checks, %d failures\n", level, checks, fails);
+}
+
+static void
+sweet_vio_strategy(buf_t bp)
+{
+	int error = 0;
+	caddr_t vaddr = NULL;
+	uint64_t off = (uint64_t)buf_blkno(bp) * sv.secsize;
+	uint32_t count = buf_count(bp);
+	uint64_t dev_bytes = sv.capacity * 512u;
+
+	buf_setresid(bp, count);
+	if (off > dev_bytes || count > dev_bytes - off) {
+		error = EINVAL;
+		goto done;
+	}
+	if (count == 0) {
+		goto done;
+	}
+	if (buf_map(bp, &vaddr)) {
+		error = EIO;
+		goto done;
+	}
+
+	boolean_t is_read = buf_flags(bp) & B_READ;
+	if (!is_read && !sv.writable) {
+		error = EROFS;
+		goto done;
+	}
+
+	lck_mtx_lock(&sweet_vio_lock);
+	for (uint32_t done = 0; done < count; done += BOUNCE_SIZE) {
+		uint32_t chunksz = MIN(BOUNCE_SIZE, count - done);
+		uint64_t sector = (off + done) >> 9;
+		uint32_t nsec = chunksz / 512u;
+		if (is_read) {
+			error = vio_read_blocks(sector, (uint8_t *)vaddr + done, nsec);
+		} else {
+			error = vio_write_blocks(sector, (const uint8_t *)vaddr + done, nsec);
+		}
+		if (error) {
+			break;
+		}
+		buf_setresid(bp, count - done - chunksz);
+	}
+	lck_mtx_unlock(&sweet_vio_lock);
+	buf_unmap(bp);
+
+done:
+	if (error) {
+		buf_seterror(bp, error);
+	}
+	buf_biodone(bp);
+}
+
+static int
+sweet_vio_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag,
+    __unused struct proc *p, int is_char)
+{
+	uint32_t *f = (uint32_t *)data;
+	uint64_t *o = (uint64_t *)data;
+
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*f = sv.secsize;
+		return 0;
+	case DKIOCSETBLOCKSIZE:
+		if (is_char) {
+			return ENODEV;
+		}
+		if (*f < DEV_BSIZE || *f > PAGE_SIZE || (*f & (*f - 1))) {
+			return EINVAL;
+		}
+		sv.secsize = *f;
+		return 0;
+	case DKIOCGETPHYSICALBLOCKSIZE:
+		*f = 512;
+		return 0;
+	case DKIOCGETBLOCKCOUNT:
+		*o = sv.capacity * 512u / sv.secsize;
+		return 0;
+	case DKIOCISWRITABLE:
+		*f = sv.writable ? 1 : 0;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTREAD:
+	case DKIOCGETMAXBLOCKCOUNTWRITE:
+		*o = BOUNCE_SIZE / sv.secsize;
+		return 0;
+	case DKIOCGETMAXSEGMENTCOUNTREAD:
+	case DKIOCGETMAXSEGMENTCOUNTWRITE:
+		*o = BOUNCE_SIZE / sv.secsize;
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+sweet_vio_bioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return sweet_vio_ioctl(dev, cmd, data, flag, p, 0);
+}
+
+static int
+sweet_vio_cioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return sweet_vio_ioctl(dev, cmd, data, flag, p, 1);
+}
+
+static int
+sweet_vio_psize(__unused dev_t dev)
+{
+	return sv.ready ? (int)MIN(sv.capacity * 512u / sv.secsize, INT_MAX) : -1;
+}
+
+static int
+sweet_vio_read(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return physio(sweet_vio_strategy, NULL, dev, B_READ, minphys, uio, (int)sv.secsize);
+}
+
+static int
+sweet_vio_write(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return physio(sweet_vio_strategy, NULL, dev, B_WRITE, minphys, uio, (int)sv.secsize);
+}
+
+static const struct bdevsw sweet_vio_bdevsw = {
+	.d_open     = sweet_vio_open,
+	.d_close    = sweet_vio_close,
+	.d_strategy = sweet_vio_strategy,
+	.d_ioctl    = sweet_vio_bioctl,
+	.d_dump     = eno_dump,
+	.d_psize    = sweet_vio_psize,
+	.d_type     = D_DISK,
+};
+
+static const struct cdevsw sweet_vio_cdevsw = {
+	.d_open       = sweet_vio_open,
+	.d_close      = sweet_vio_close,
+	.d_read       = sweet_vio_read,
+	.d_write      = sweet_vio_write,
+	.d_ioctl      = sweet_vio_cioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = D_DISK,
+};
+
+/* ---- virtio-input: a real input path for QEMU -----------------------------
+ *
+ * QEMU's virtio-tablet-device / virtio-keyboard-device sit on the same
+ * virtio-mmio strap as the disk. The tablet reports absolute coordinates
+ * (EV_ABS ABS_X/ABS_Y + BTN_TOUCH), the mouse relative ones and the keyboard
+ * Linux key codes; all of it is forwarded to the HID services
+ * (sweet_hid_touch / sweet_hid_key) that backboardd already talks to. Only
+ * the event queue (queue 0) is used and it is polled from a kernel thread, so
+ * no interrupt wiring is needed.
+ */
+
+#define VDEV_ID_INPUT        18
+#define VIN_QSIZE            64
+#define VIN_EV_SIZE          8u
+#define VIN_OFF_DESC         0x0000
+#define VIN_OFF_AVAIL        0x0400
+#define VIN_OFF_USED         0x0800
+#define VIN_OFF_EVENTS       0x1000
+#define VIN_DMA_SIZE         0x2000
+
+#define VIN_CFG_ID_NAME      1
+#define VIN_CFG_ABS_INFO     4
+#define VIN_EV_SYN           0
+#define VIN_EV_KEY           1
+#define VIN_EV_REL           2
+#define VIN_EV_ABS           3
+#define VIN_SYN_REPORT       0
+#define VIN_ABS_X            0
+#define VIN_ABS_Y            1
+#define VIN_REL_X            0
+#define VIN_REL_Y            1
+#define VIN_BTN_LEFT         0x110
+#define VIN_BTN_TOUCH        0x14a
+#define VIN_KEY_HOME         102
+#define VIN_KEY_HOMEPAGE     172
+#define VIN_KEY_POWER        116
+#define VIN_KEY_VOLUMEUP     115
+#define VIN_KEY_VOLUMEDOWN   114
+#define VIN_PANEL_W          1080
+#define VIN_PANEL_H          2400
+#define VIN_REL_STEP         8
+
+struct vin_event {
+	uint16_t type;
+	uint16_t code;
+	uint32_t value;
+} __attribute__((packed));
+
+static struct {
+	vm_offset_t regs;
+	vm_offset_t dma;
+	uint64_t dma_pa;
+	uint32_t qsize;
+	uint16_t avail;
+	uint16_t seen;
+	int32_t amin[2], amax[2];
+	int x, y;
+	bool touch, moved, changed;
+	bool running, ready;
+	uint32_t events, keys, flushes;
+	uint32_t last_type, last_code, last_value;
+	char name[32];
+} vin;
+
+static int vin_sleep_chan;
+
+extern void sweet_hid_key(int key, int down);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+void sweet_input_start(uintptr_t window_pa, uint32_t window_size);
+
+static inline uint32_t
+vin_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(vin.regs + off);
+}
+
+static inline void
+vin_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(vin.regs + off) = v;
+}
+
+static inline void
+vin_barrier(void)
+{
+	__builtin_arm_dsb(0xf);
+}
+
+static void
+vin_read_name(void)
+{
+	volatile uint8_t *cfg = (volatile uint8_t *)(vin.regs + REG_CONFIG);
+	uint32_t n;
+
+	cfg[0] = VIN_CFG_ID_NAME;
+	cfg[1] = 0;
+	n = cfg[2];
+	if (n >= sizeof(vin.name)) {
+		n = sizeof(vin.name) - 1;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		vin.name[i] = (char)cfg[8 + i];
+	}
+	vin.name[n] = 0;
+}
+
+static void
+vin_read_abs(void)
+{
+	volatile uint8_t *cfg = (volatile uint8_t *)(vin.regs + REG_CONFIG);
+
+	for (int axis = 0; axis < 2; axis++) {
+		cfg[0] = VIN_CFG_ABS_INFO;
+		cfg[1] = (uint8_t)axis;
+		vin.amin[axis] = (int32_t)*(volatile uint32_t *)(cfg + 8);
+		vin.amax[axis] = (int32_t)*(volatile uint32_t *)(cfg + 12);
+		if (vin.amax[axis] <= vin.amin[axis]) {
+			vin.amin[axis] = 0;
+			vin.amax[axis] = 0x7fff;
+		}
+	}
+}
+
+static int
+vin_scale(uint32_t value, int axis)
+{
+	int64_t lo = vin.amin[axis], hi = vin.amax[axis];
+	int64_t span = hi - lo;
+	int64_t t = (int64_t)value - lo;
+
+	if (span <= 0) {
+		return axis ? VIN_PANEL_H / 2 : VIN_PANEL_W / 2;
+	}
+	if (t < 0) {
+		t = 0;
+	}
+	if (t > span) {
+		t = span;
+	}
+	return (int)((t * (axis ? VIN_PANEL_H : VIN_PANEL_W)) / span);
+}
+
+/* One touch event per SYN_REPORT, like a real digitizer. */
+static void
+vin_flush(void)
+{
+	bool send = vin.changed || (vin.touch && vin.moved);
+
+	if (vin.x < 0) {
+		vin.x = 0;
+	}
+	if (vin.x > VIN_PANEL_W - 1) {
+		vin.x = VIN_PANEL_W - 1;
+	}
+	if (vin.y < 0) {
+		vin.y = 0;
+	}
+	if (vin.y > VIN_PANEL_H - 1) {
+		vin.y = VIN_PANEL_H - 1;
+	}
+	if (send) {
+		printf("SWEET INPUT: touch %s at %d,%d\n", vin.touch ? "down" : "up",
+		    vin.x, vin.y);
+		sweet_hid_touch(0, vin.touch ? 1 : 0, vin.x, vin.y);
+		vin.flushes++;
+	}
+	vin.changed = false;
+	vin.moved = false;
+}
+
+static void
+vin_event(uint16_t type, uint16_t code, uint32_t value)
+{
+	vin.events++;
+	vin.last_type = type;
+	vin.last_code = code;
+	vin.last_value = value;
+
+	switch (type) {
+	case VIN_EV_KEY:
+		switch (code) {
+		case VIN_BTN_TOUCH:
+		case VIN_BTN_LEFT:
+			vin.touch = value != 0;
+			vin.changed = true;
+			break;
+		case VIN_KEY_HOME:
+		case VIN_KEY_HOMEPAGE:
+			sweet_hid_key(3, value != 0);
+			vin.keys++;
+			break;
+		case VIN_KEY_POWER:
+			sweet_hid_key(0, value != 0);
+			vin.keys++;
+			break;
+		case VIN_KEY_VOLUMEUP:
+			sweet_hid_key(1, value != 0);
+			vin.keys++;
+			break;
+		case VIN_KEY_VOLUMEDOWN:
+			sweet_hid_key(2, value != 0);
+			vin.keys++;
+			break;
+		default:
+			break;
+		}
+		break;
+	case VIN_EV_ABS:
+		if (code == VIN_ABS_X) {
+			vin.x = vin_scale(value, 0);
+			vin.moved = true;
+		} else if (code == VIN_ABS_Y) {
+			vin.y = vin_scale(value, 1);
+			vin.moved = true;
+		}
+		break;
+	case VIN_EV_REL:
+		if (code == VIN_REL_X) {
+			vin.x += (int)value * VIN_REL_STEP;
+			vin.moved = true;
+		} else if (code == VIN_REL_Y) {
+			vin.y += (int)value * VIN_REL_STEP;
+			vin.moved = true;
+		}
+		break;
+	case VIN_EV_SYN:
+		if (code == VIN_SYN_REPORT) {
+			vin_flush();
+		}
+		break;
+	default:
+		break;
+	}
+}
+
+static void
+vin_wait(void)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(10, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&vin_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+vin_thread(void *arg, wait_result_t result)
+{
+	volatile uint16_t *avail_idx = (volatile uint16_t *)(vin.dma + VIN_OFF_AVAIL + 2);
+	volatile uint16_t *avail_ring = (volatile uint16_t *)(vin.dma + VIN_OFF_AVAIL + 4);
+	volatile uint16_t *used_idx = (volatile uint16_t *)(vin.dma + VIN_OFF_USED + 2);
+	(void)arg;
+	(void)result;
+
+	for (;;) {
+		bool returned = false;
+		uint16_t used;
+
+		vin_barrier();
+		FlushPoC_DcacheRegion(vin.dma + VIN_OFF_USED, 0x400 + 8 * vin.qsize);
+		FlushPoC_DcacheRegion(vin.dma + VIN_OFF_EVENTS, VIN_EV_SIZE * vin.qsize);
+		used = *used_idx;
+		while (vin.seen != used) {
+			struct vring_used_elem *e = (struct vring_used_elem *)
+			    (vin.dma + VIN_OFF_USED + 4 + 8 * (vin.seen % vin.qsize));
+			uint16_t id = (uint16_t)e->id;
+			struct vin_event ev;
+
+			vin.seen++;
+			if (id >= vin.qsize) {
+				printf("SWEET INPUT: bogus used id %u\n", id);
+				continue;
+			}
+			ev = *(struct vin_event *)(vin.dma + VIN_OFF_EVENTS +
+			    id * VIN_EV_SIZE);
+			vin_event(ev.type, ev.code, ev.value);
+			avail_ring[vin.avail % vin.qsize] = id;
+			vin.avail++;
+			returned = true;
+		}
+		if (returned) {
+			CleanPoC_DcacheRegion(vin.dma + VIN_OFF_AVAIL, 0x400);
+			vin_barrier();
+			*avail_idx = vin.avail;
+			vin_barrier();
+			vin_wr(REG_QUEUE_NOTIFY, 0);
+		}
+		vin_wait();
+	}
+}
+
+void
+sweet_input_start(uintptr_t window_pa, uint32_t window_size)
+{
+	struct vdesc *desc;
+	thread_t thread;
+	int found = -1;
+	uint32_t max;
+
+	if (vin.running) {
+		return;
+	}
+	vin.running = true;
+
+	for (uint32_t slot = 0; slot < window_size / VPOS_STRIDE; ++slot) {
+		vm_offset_t regs = ml_io_map(window_pa + slot * VPOS_STRIDE,
+		    VPOS_STRIDE);
+		if (*(volatile uint32_t *)(regs + REG_MAGIC) == VSIG_MAGIC &&
+		    *(volatile uint32_t *)(regs + REG_VERSION) == VERSION_MMIO &&
+		    *(volatile uint32_t *)(regs + REG_DEVICE_ID) == VDEV_ID_INPUT) {
+			vin.regs = regs;
+			found = (int)slot;
+			break;
+		}
+	}
+	if (found < 0) {
+		vin.regs = 0;
+		printf("SWEET INPUT: no virtio-input device in the mmio window\n");
+		return;
+	}
+
+	vin_wr(REG_STATUS, 0);
+	while (vin_rd(REG_STATUS)) {
+		delay(10);
+	}
+	vin_wr(REG_STATUS, VST_ACKNOWLEDGE);
+	vin_wr(REG_STATUS, VST_ACKNOWLEDGE | VST_DRIVER);
+	vin_wr(REG_DEVICE_FEAT_SEL, 1);
+	if (!(vin_rd(REG_DEVICE_FEATURES) & 1)) {
+		printf("SWEET INPUT: device does not offer VIRTIO_F_VERSION_1\n");
+		return;
+	}
+	vin_wr(REG_DRIVER_FEAT_SEL, 1);
+	vin_wr(REG_DRIVER_FEATURES, 1);
+	vin_wr(REG_STATUS, VST_ACKNOWLEDGE | VST_DRIVER | VST_FEATURES_OK);
+	if (!(vin_rd(REG_STATUS) & VST_FEATURES_OK)) {
+		printf("SWEET INPUT: FEATURES_OK rejected\n");
+		return;
+	}
+
+	vin_wr(REG_QUEUE_SEL, 0);
+	max = vin_rd(REG_QUEUE_NUM_MAX);
+	if (max < 8) {
+		printf("SWEET INPUT: queue max %u too small\n", max);
+		return;
+	}
+	vin.qsize = VIN_QSIZE;
+	while (vin.qsize > max) {
+		vin.qsize >>= 1;
+	}
+
+	if (kmem_alloc_contig(kernel_map, &vin.dma, VIN_DMA_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET INPUT: no contiguous DMA memory\n");
+		return;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)vin.dma);
+	if (!pn) {
+		printf("SWEET INPUT: no physical address for the ring\n");
+		return;
+	}
+	vin.dma_pa = ptoa_64(pn);
+
+	vin_read_name();
+	vin_read_abs();
+
+	desc = (struct vdesc *)(vin.dma + VIN_OFF_DESC);
+	for (uint32_t i = 0; i < vin.qsize; i++) {
+		desc[i].addr = vin.dma_pa + VIN_OFF_EVENTS + i * VIN_EV_SIZE;
+		desc[i].len = VIN_EV_SIZE;
+		desc[i].flags = VRING_DESC_F_WRITE;
+		desc[i].next = 0;
+		((uint16_t *)(vin.dma + VIN_OFF_AVAIL + 4))[i] = (uint16_t)i;
+	}
+	vin.avail = (uint16_t)vin.qsize;
+	vin.seen = 0;
+	*(volatile uint16_t *)(vin.dma + VIN_OFF_AVAIL) = 0;
+	*(volatile uint16_t *)(vin.dma + VIN_OFF_AVAIL + 2) = vin.avail;
+	CleanPoC_DcacheRegion(vin.dma, VIN_DMA_SIZE);
+	vin_barrier();
+
+	vin_wr(REG_QUEUE_NUM, vin.qsize);
+	vin_wr(REG_QUEUE_READY, 0);
+	vin_wr(REG_QUEUE_DESC_LO, (uint32_t)(vin.dma_pa + VIN_OFF_DESC));
+	vin_wr(REG_QUEUE_DESC_HI, (uint32_t)((vin.dma_pa + VIN_OFF_DESC) >> 32));
+	vin_wr(REG_QUEUE_AVAIL_LO, (uint32_t)(vin.dma_pa + VIN_OFF_AVAIL));
+	vin_wr(REG_QUEUE_AVAIL_HI, (uint32_t)((vin.dma_pa + VIN_OFF_AVAIL) >> 32));
+	vin_wr(REG_QUEUE_USED_LO, (uint32_t)(vin.dma_pa + VIN_OFF_USED));
+	vin_wr(REG_QUEUE_USED_HI, (uint32_t)((vin.dma_pa + VIN_OFF_USED) >> 32));
+	vin_wr(REG_QUEUE_READY, 1);
+	vin_wr(REG_STATUS, VST_ACKNOWLEDGE | VST_DRIVER | VST_FEATURES_OK |
+	    VST_DRIVER_OK);
+	vin.ready = true;
+
+	printf("SWEET INPUT: virtio-input \"%s\" at transport %d (%#x), queue %u, "
+	    "abs %d..%d x %d..%d\n", vin.name, found,
+	    (uint32_t)(window_pa + (uint32_t)found * VPOS_STRIDE), vin.qsize,
+	    vin.amin[0], vin.amax[0], vin.amin[1], vin.amax[1]);
+
+	if (kernel_thread_start(vin_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET INPUT: kernel_thread_start failed\n");
+	}
+}
+
+static int
+sweet_vio_init(void)
+{
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	unsigned int size = 0;
+	int error;
+
+	if (SecureDTLookupEntry(NULL, "/sweet-virtio", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size < 2 * sizeof(uintptr_t)) {
+		printf("SWEET VIO: no /sweet-virtio node in the device tree\n");
+		return ENXIO;
+	}
+
+	/* Input first: it works even if no disk is attached (sweetfb test). */
+	sweet_input_start((uintptr_t)reg[0], (uint32_t)reg[1]);
+
+	/*
+	 * The ADT gives the whole virtio-mmio window; QEMU picks which of the
+	 * 32 transports hosts a -device (it uses the last free bus), so scan
+	 * for the virtio-blk signature rather than trusting a fixed slot.
+	 */
+	bool found = false;
+	for (uint32_t slot = 0; slot < reg[1] / VPOS_STRIDE; ++slot) {
+		sv.regs = ml_io_map(reg[0] + slot * VPOS_STRIDE, VPOS_STRIDE);
+		if (vio_rd(REG_MAGIC) == VSIG_MAGIC && vio_rd(REG_VERSION) == VERSION_MMIO &&
+		    vio_rd(REG_DEVICE_ID) == VDEV_ID_BLK) {
+			printf("SWEET VIO: virtio-blk at transport %u (%#x)\n", slot,
+			    (uint32_t)(reg[0] + slot * VPOS_STRIDE));
+			found = true;
+			break;
+		}
+	}
+	if (!found) {
+		sv.regs = 0;	/* vm_offset_t: NULL is a void * and clang 16 rejects the conversion */
+		printf("SWEET VIO: no virtio-mmio transport with a blk device found\n");
+		return ENXIO;
+	}
+	if (kmem_alloc_contig(kernel_map, &sv.dma, DMA_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET VIO: no contiguous DMA memory\n");
+		return ENOMEM;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)sv.dma);
+	if (!pn) {
+		return ENOMEM;
+	}
+	sv.dma_pa = ptoa_64(pn);
+	sv.secsize = DEV_BSIZE;
+	sv.writable = true;
+
+	vio_sync_all(true);                     /* publish even a zeroed ring */
+	lck_mtx_lock(&sweet_vio_lock);
+	vio_init_ring_memory();
+	error = vio_transport_setup();
+	lck_mtx_unlock(&sweet_vio_lock);
+	if (error) {
+		return error;
+	}
+
+	uint32_t test = 0;
+	PE_parse_boot_argn("sweetvio_test", &test, sizeof(test));
+	if (test >= 1 && test <= 2) {
+		sweet_vio_self_test(test);
+	}
+
+	uint32_t pdump = 0;
+	PE_parse_boot_argn("sweetproc_dump", &pdump, sizeof(pdump));
+	if (pdump && sweet_proc_left == 0) {
+		sweet_proc_ticks = (int)pdump * hz;
+		sweet_proc_left = 6;
+		timeout(sweet_proc_timer, NULL, sweet_proc_ticks);
+	}
+
+	uint32_t sample = 0;
+	if (!PE_parse_boot_argn("sweet_sample_names", sweet_sample_names,
+	    sizeof(sweet_sample_names))) {
+		strlcpy(sweet_sample_names, "SpringBoard",
+		    sizeof(sweet_sample_names));
+	}
+	PE_parse_boot_argn("sweet_sample", &sample, sizeof(sample));
+	if (sample && sweet_sample_left == 0) {
+		sweet_sample_ticks = (int)sample * hz;
+		sweet_sample_left = 3;
+		timeout(sweet_sample_timer, NULL, sweet_sample_ticks);
+	}
+
+	sv.bmajor = bdevsw_add(-1, &sweet_vio_bdevsw);
+	if (sv.bmajor < 0) {
+		return ENXIO;
+	}
+	sv.cmajor = cdevsw_add_with_bdev(-1, &sweet_vio_cdevsw, sv.bmajor);
+	if (sv.cmajor < 0) {
+		return ENXIO;
+	}
+	sv.bdev = makedev(sv.bmajor, 0);
+	devfs_make_node(sv.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "vroot0");
+	devfs_make_node(makedev(sv.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "rvroot0");
+	sv.ready = true;
+	printf("SWEET VIO: disk vroot0 (%llu MiB, %s)\n",
+	    sv.capacity >> 11, sv.writable ? "read/write" : "read-only");
+	return 0;
+}
+
+/* Root device for rd=vroot0 (IOFindBSDRoot). */
+int sweet_vio_rootdev(dev_t *dev);
+
+int
+sweet_vio_rootdev(dev_t *dev)
+{
+	if (!sv.ready) {
+		int error = sweet_vio_init();
+		if (error) {
+			return error;
+		}
+	}
+	*dev = sv.bdev;
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
