 static uint64_t sweet_sandbox_seen;
 
+/*
+ * Dump the user request of the container-path sandbox operations so the
+ * request layout can be recovered from the guest log (the kernel will
+ * eventually answer op 4 itself and cut the containermanagerd XPC fallback
+ * that races SpringBoard's first launch).  Diagnostic only: the operations
+ * still return ENOENT.
+ */
+static void
+sweet_sandbox_dump_req(struct proc *p, int call, user_addr_t arg)
+{
+	uint8_t buf[384];
+	int len = 0;
+	static const int tries[] = { 384, 128, 32 };
+	char name[32];
+	unsigned i;
+
+	for (i = 0; i < sizeof(tries) / sizeof(tries[0]); i++) {
+		if (arg != 0 && copyin(arg, buf, tries[i]) == 0) {
+			len = tries[i];
+			break;
+		}
+	}
+	proc_name(proc_pid(p), name, sizeof(name));
+	if (len == 0) {
+		printf("SWEET Sandbox: %s op %d arg %#llx copyin failed\n",
+		    name, call, (unsigned long long)arg);
+		return;
+	}
+	printf("SWEET Sandbox: %s op %d req %d bytes at %#llx\n",
+	    name, call, len, (unsigned long long)arg);
+	for (i = 0; i + 15 < (unsigned)len; i += 16) {
+		printf("SWEET SB %3d: %02x %02x %02x %02x %02x %02x %02x %02x "
+		    "%02x %02x %02x %02x %02x %02x %02x %02x\n",
+		    i, buf[i], buf[i+1], buf[i+2], buf[i+3],
+		    buf[i+4], buf[i+5], buf[i+6], buf[i+7],
+		    buf[i+8], buf[i+9], buf[i+10], buf[i+11],
+		    buf[i+12], buf[i+13], buf[i+14], buf[i+15]);
+	}
+}
+
 static int
 sweet_sandbox_syscall(struct proc *p, int call, __unused user_addr_t arg)
 {
@@ -296,9 +336,12 @@
 	}
 	switch (call) {
 	case 4:         /* container path (audit token / pid) */
+		sweet_sandbox_dump_req(p, call, arg);
+		return ENOENT;
 	case 5:         /* extension issue */
 	case 6:         /* extension consume */
 	case 0x43:      /* container expected */
+		sweet_sandbox_dump_req(p, call, arg);
 		return ENOENT;
 	default:
 		return 0;
